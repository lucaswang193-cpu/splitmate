# Create application-test-local.properties with your own local test credentials.
# Tests recreate tables, so always use a separate test database.
spring.datasource.url=${TEST_DB_URL:jdbc:sqlserver://localhost:1433;databaseName=splitmate_test;encrypt=true;trustServerCertificate=true}
spring.datasource.username=${TEST_DB_USERNAME:YOUR_TEST_DATABASE_USERNAME}
spring.datasource.password=${TEST_DB_PASSWORD:YOUR_TEST_DATABASE_PASSWORD}
